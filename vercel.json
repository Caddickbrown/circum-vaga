{
  "routes": [
    {
      "src": "/football(/.*)?",
      "has": [{ "type": "host", "value": "(www\\.)?circumvaga\\.co\\.uk" }],
      "status": 307,
      "headers": { "Location": "https://football.circumvaga.co.uk$1" }
    },
    {
      "src": "/",
      "has": [{ "type": "host", "value": "football.circumvaga.co.uk" }],
      "dest": "/football/index.html"
    },
    {
      "src": "/(.+)",
      "has": [{ "type": "host", "value": "football.circumvaga.co.uk" }],
      "dest": "/football/$1"
    },
    {
      "src": "/(blog|sponsors|winners)\\.html",
      "status": 308,
      "headers": { "Location": "/$1" }
    },
    { "handle": "filesystem" },
    { "src": "/(blog|sponsors|winners)", "dest": "/$1.html" }
  ]
}
