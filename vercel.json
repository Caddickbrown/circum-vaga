{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/football/:path*",
      "has": [{ "type": "host", "value": "(www\\.)?circumvaga\\.co\\.uk" }],
      "destination": "https://football.circumvaga.co.uk/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "football.circumvaga.co.uk" }],
      "destination": "/football"
    },
    {
      "source": "/:path+",
      "has": [{ "type": "host", "value": "football.circumvaga.co.uk" }],
      "destination": "/football/:path+"
    }
  ]
}
